{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQPlayer",
  "version": "1.0.0",
  "identifier": "com.daxmate.qqplayer",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:17627",
    "beforeBuildCommand": "",
    "frontendDist": "../../../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "resources": ["resources/backend/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
