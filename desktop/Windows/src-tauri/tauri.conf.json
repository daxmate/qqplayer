{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQPlayer",
  "version": "1.1.0",
  "identifier": "com.daxmate.qqplayer",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:17627",
    "beforeBuildCommand": "",
    "frontendDist": "../../../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "http://127.0.0.1:17627",
        "title": "QQPlayer",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/backend/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
