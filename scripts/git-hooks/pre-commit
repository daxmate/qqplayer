#!/usr/bin/env bash
# pre-commit hook: 提交前自动检查代码格式（防 CI 连红）
#   后端: ruff format --check + ruff check（仅暂存的 .py）
#   前端: prettier --check（仅暂存的 .vue/.js/.ts/.css/.scss/.json/.html 等）
# 工具缺失时警告放行（CI 兜底），避免首次 clone 未装依赖时阻塞提交
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0

# ---------- 后端 ruff ----------
py_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' 2>/dev/null)
if [ -n "$py_files" ]; then
  if [ -x backend/venv/bin/ruff ]; then
    RUFF=backend/venv/bin/ruff
  elif command -v ruff >/dev/null 2>&1; then
    RUFF=ruff
  else
    echo "⚠️  ruff 未安装，跳过后端格式检查（CI 会兜底）"
  fi
  if [ -n "${RUFF:-}" ]; then
    echo "→ ruff format --check"
    # shellcheck disable=SC2086
    $RUFF format --check $py_files || fail=1
    echo "→ ruff check"
    # shellcheck disable=SC2086
    $RUFF check $py_files || fail=1
  fi
fi

# ---------- 前端 prettier ----------
fe_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.vue' '*.js' '*.ts' '*.mjs' '*.cjs' '*.css' '*.scss' '*.json' '*.html' 2>/dev/null)
if [ -n "$fe_files" ]; then
  if [ -x frontend/node_modules/.bin/prettier ]; then
    PRETTIER=frontend/node_modules/.bin/prettier
  elif command -v prettier >/dev/null 2>&1; then
    PRETTIER=prettier
  else
    echo "⚠️  prettier 未安装，跳过前端格式检查（CI 会兜底）"
  fi
  if [ -n "${PRETTIER:-}" ]; then
    echo "→ prettier --check"
    # shellcheck disable=SC2086
    $PRETTIER --check $fe_files || fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "❌ 格式检查未通过，提交已阻止。请先格式化："
  echo "   后端: backend/venv/bin/ruff format . && backend/venv/bin/ruff check --fix ."
  echo "   前端: cd frontend && pnpm exec prettier --write <files>"
  exit 1
fi

exit 0
